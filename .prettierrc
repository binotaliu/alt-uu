{
    "semi": true,
    "singleQuote": true,
    "singleAttributePerLine": false,
    "printWidth": 80,
    "tabWidth": 4,
    "trailingComma": "all",
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindFunctions": ["clsx", "cn", "cva"],
    "tailwindConfig": "./apps/mobile/tailwind.config.js",
    "overrides": [
        {
            "files": "**/*.{yml,yaml}",
            "options": { "tabWidth": 2 }
        }
    ]
}
