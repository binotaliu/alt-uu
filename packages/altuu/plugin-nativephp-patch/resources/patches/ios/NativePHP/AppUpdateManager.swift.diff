+    private func extractVersionCodeFromEnv(_ envContent: String) -> String? {
+        let lines = envContent.components(separatedBy: .newlines)
+        for line in lines {
+            if line.hasPrefix("NATIVEPHP_APP_VERSION_CODE=") {
+                let versionCode = String(line.dropFirst("NATIVEPHP_APP_VERSION_CODE=".count))
+                let trimmedVersionCode = versionCode.trimmingCharacters(in: .whitespacesAndNewlines)
+                let cleanVersionCode = trimmedVersionCode.trimmingCharacters(in: CharacterSet(charactersIn: "\"'"))
+                return cleanVersionCode
+            }
+        }
+        return nil
+    }
