+    private fun dispatchBackPressedEventToWebView(onResult: (Boolean) -> Unit) {
+        val web = webRenderer?.webView
+        if (web == null) {
+            onResult(false)
+            return
+        }
 
+        val backPressScript = """
+            (() => {
+                try {
+                    const event = new CustomEvent('nativephp:back-pressed', {
+                        cancelable: true,
+                        detail: { source: 'android' },
+                    })
+
+                    window.dispatchEvent(event)
+
+                    return event.defaultPrevented ? 'handled' : 'unhandled'
+                } catch (_) {
+                    return 'error'
+                }
+            })();
+        """.trimIndent()
+
+        web.post {
+            web.evaluateJavascript(backPressScript) { result ->
+                val normalized = result?.trim()?.trim('"')
+                onResult(normalized == "handled")
+            }
+        }
+    }
