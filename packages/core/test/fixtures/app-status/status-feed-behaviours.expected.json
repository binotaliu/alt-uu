{
    "source": "Feature/AppStatus/AppStatusControllerTest.php:270-294",
    "phpClass": "AltUU\\Domains\\AppStatus\\AppStatusFeedClient / DismissAppStatusItem",
    "note": "Behavioural cases that cannot be a static scenario.",
    "cases": [
        {
            "name": "rejects dismissal keys of an unknown kind",
            "input": {
                "dismissKeys": [
                    "",
                    "whatever",
                    "update:",
                    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                ]
            },
            "expected": {
                "httpStatus": 422
            }
        },
        {
            "name": "serves the feed from cache instead of refetching",
            "input": {
                "requests": "GET /api/app-status twice"
            },
            "expected": {
                "feedHttpRequestCount": 1
            }
        },
        {
            "name": "falls back to the last good feed and backs off while the feed is down",
            "input": {
                "steps": [
                    "feed OK with 1 announcement -> GET shows 1",
                    "forget cache key app-status:feed; feed now 503 \"down\"",
                    "GET twice -> still shows 1 announcement"
                ]
            },
            "expected": {
                "announcementsCount": 1,
                "feedHttpRequestCount": 1,
                "note": "the failing fetch is not retried on the second GET (backoff)"
            }
        }
    ]
}
