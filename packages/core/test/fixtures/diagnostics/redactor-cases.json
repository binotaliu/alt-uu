    },
    {
        "name": "strips credential query parameters from urls but keeps the diagnostic part",
        "op": "redactUrl",
        "salt": "test-salt",
        "input": "https://uu.nou.edu.tw/xmlapi/index.php?action=getCourseList&ticket=SECRET123&ua=Mozilla&page=2"
    },
    {
        "name": "leaves an ordinary message untouched",
        "op": "redactText",
        "salt": "test-salt",
        "input": "讀取作業列表失敗。"
    },
    {
        "name": "redactSecrets drops credentials from html source but leaves identifiers and structure alone",
        "op": "redactSecrets",
        "salt": "test-salt",
        "input": "<meta name=\"viewport\" content=\"width=1\"><a href=\"https://uu.nou.edu.tw/x?ticket=abc123&page=2\">u</a><script>var cfg = {\"password\":\"hunter2\"};</script> user u1001 mail@example.com"
    },
    {
        "name": "redactSecrets returns empty text unchanged",
        "op": "redactSecrets",
        "salt": "test-salt",
        "input": ""
    },
    {
        "name": "redactText masks a credential in a URL query string inside free text",
