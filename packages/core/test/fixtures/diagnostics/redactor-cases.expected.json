            "input": {
                "op": "redact",
                "salt": "test-salt",
                "input": {
                    "refreshToken": "super-secret-value"
                }
            },
            "expected": {
                "refreshToken": "[已遮蔽]",
                "valueNotContains": "super-secret-value"
            }
        },
        {
            "name": "drops secret-bearing key: apiKey",
            "input": {
                "op": "redact",
