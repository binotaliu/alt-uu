{
    "source": "Unit/Diagnostics/DiagnosticRedactorTest.php:12-150",
    "phpClass": "App\\Services\\Diagnostics\\DiagnosticRedactor",
    "note": "op = redact(array) | redactText | redactUrl | redactSecrets | pseudonymizeStable | pseudonymizeSalts. Salt \"test-salt\" unless given. REDACTED constant = \"[已遮蔽]\". Golden holds the exact PHP output (including pseudonym handles for salt \"test-salt\").",
    "cases": [
        {
            "name": "drops secret-bearing key: password",
            "input": {
                "op": "redact",
                "salt": "test-salt",
                "input": {
                    "password": "super-secret-value"
                }
            },
            "expected": {
                "password": "[已遮蔽]",
                "valueNotContains": "super-secret-value"
            }
        },
        {
            "name": "drops secret-bearing key: ticket",
            "input": {
                "op": "redact",
                "salt": "test-salt",
                "input": {
                    "ticket": "super-secret-value"
                }
            },
            "expected": {
                "ticket": "[已遮蔽]",
                "valueNotContains": "super-secret-value"
            }
        },
        {
            "name": "drops secret-bearing key: session_idx",
            "input": {
                "op": "redact",
                "salt": "test-salt",
                "input": {
