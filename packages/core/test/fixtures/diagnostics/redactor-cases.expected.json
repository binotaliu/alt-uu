                    "Set-Cookie": "super-secret-value"
                }
            },
            "expected": {
                "Set-Cookie": "[已遮蔽]",
                "valueNotContains": "super-secret-value"
            }
        },
        {
            "name": "drops secret-bearing key: authorization",
            "input": {
                "op": "redact",
