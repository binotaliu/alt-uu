{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,html,blade.php,json,md,yml,yaml,vue}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,html,blade.php,json,md,yml,yaml,vue}\"",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "prepare": "husky install",
        "lint:commit": "commitlint --edit $1"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^9.19.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.1.0",
        "eslint-plugin-vue": "^9.3.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.4.2",
        "prettier-plugin-blade": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "@tailwindcss/typography": "^0.5.19",
        "@vitejs/plugin-vue": "^6.0.5",
        "axios": "^1.16.0",
        "laravel-vite-plugin": "^2.0.0",
        "pinia": "^3.0.4",
        "tailwindcss": "^4.1.1",
        "vue": "^3.5.30",
        "vue-router": "^4.6.4"
    },
    "imports": {
        "#nativephp": "./vendor/nativephp/mobile/resources/dist/native.js"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "lint-staged": {
        "*.{css,scss,html,json,md}": [
            "prettier --write"
        ],
        "*.{js,jsx,ts,tsx,vue}": [
            "prettier --write",
            "eslint --fix"
        ],
        "*.php": [
            "./vendor/bin/pint"
        ],
        "*.blade.php": [
            "prettier --write"
        ]
    },
    "config": {}
}
