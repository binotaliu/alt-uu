{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "format": "prettier --write \"**/*.{js,cjs,css,html,blade.php,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,css,html,blade.php,json,md,yml,yaml}\"",
        "prepare": "husky install",
        "lint:commit": "commitlint --edit $1"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "concurrently": "^9.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.4.2",
        "prettier-plugin-blade": "^3.0.0"
    },
    "lint-staged": {
        "*.{js,cjs,css,html,json,md}": [
            "prettier --write"
        ],
        "*.php": [
            "./vendor/bin/pint"
        ],
        "*.blade.php": [
            "prettier --write"
        ]
    },
    "config": {}
}
